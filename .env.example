# ===========================================
# Database per microservice (fallback: DB_MASTER_*)
# ===========================================
# Shared fallback (optional - used when DB_*_* not set)
DB_MASTER_HOST=localhost
DB_MASTER_PORT=5432
DB_MASTER_USERNAME=postgres
DB_MASTER_PASSWORD=postgres
DB_MASTER_DATABASE=app

# Order service
DB_ORDER_HOST=localhost
DB_ORDER_PORT=5432
DB_ORDER_USERNAME=postgres
DB_ORDER_PASSWORD=postgres
DB_ORDER_DATABASE=order_db

# User service
DB_USER_HOST=localhost
DB_USER_PORT=5432
DB_USER_USERNAME=postgres
DB_USER_PASSWORD=postgres
DB_USER_DATABASE=user_db

# Cat service
DB_CAT_HOST=localhost
DB_CAT_PORT=5432
DB_CAT_USERNAME=postgres
DB_CAT_PASSWORD=postgres
DB_CAT_DATABASE=cat_db

# Cart service
DB_CART_HOST=localhost
DB_CART_PORT=5432
DB_CART_USERNAME=postgres
DB_CART_PASSWORD=postgres
DB_CART_DATABASE=cart_db

# Breed service
DB_BREED_HOST=localhost
DB_BREED_PORT=5432
DB_BREED_USERNAME=postgres
DB_BREED_PASSWORD=postgres
DB_BREED_DATABASE=breed_db

# Common
DB_SYNCHRONIZE=true
DB_LOGGING=false

# ===========================================
# App / Gateway
# ===========================================
HTTP_PORT=3000

# ===========================================
# Microservices (when run standalone)
# ===========================================
ORDER_HTTP_PORT=3001
USER_HTTP_PORT=3002
CAT_HTTP_PORT=3003
